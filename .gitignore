# ==============================================================================
# Root .gitignore for FarmLife Project
# Workspace structure:
#   - FarmLife_Spring/ (Spring Boot Java multi-module)
#   - FarmLife_Unity/  (Unity Game Engine project)
#   - docs/ & AGENTS.md (Documentation)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Unity Ignore Rules (Crucial for game engine repository)
# ------------------------------------------------------------------------------
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emory[Cc]aptures/
**/[Rr]ecordings/

# Autogenerated IDE project files for Unity
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated crash reports / metadata / assets
**/sysinfo.txt
*.stackdump
crashlytics-build.properties
**/[Aa]ssets/Plugins/Editor/JetBrains*
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity build outputs
*.apk
*.aab
*.unitypackage
*.app

# ------------------------------------------------------------------------------
# 2. Java / Spring Boot / Maven Ignore Rules
# ------------------------------------------------------------------------------
**/target/
*.class

# Log files
*.log
**/logs/

# Build artifacts
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ------------------------------------------------------------------------------
# 3. Environment & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# ------------------------------------------------------------------------------
# 4. IDEs & Editors
# ------------------------------------------------------------------------------
# JetBrains / IntelliJ IDEA
.idea/
**/.idea/
*.iml
*.iws
*.ipr
out/
**/out/

# Visual Studio
.vs/
**/.vs/

# Visual Studio Code
.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json

# Eclipse
.classpath
.project
.settings/

# ------------------------------------------------------------------------------
# 5. OS Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini
